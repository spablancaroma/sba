# 拡張子の競合やMultiViewsによるエラーを防ぐ
Options -MultiViews

#SSLREDIRECT
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
</IfModule>
#SSLREDIRECT

#DOMAINREDIRECT
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^st599405.static.jp
RewriteRule ^(.*) https://spa-blanc-aroma.com/$1 [R=302,L]
</IfModule>
#DOMAINREDIRECT

#EXTENSIONLESS (拡張子なし表示の設定)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
</IfModule>
#EXTENSIONLESS
